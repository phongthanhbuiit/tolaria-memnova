  {
    "name": "CRLF and metadata",
    "source": "# Canvas\r\nVisible prose.\r\n   ````tldraw id=\"a\" height=\"520\"\r\n{\"store\":{}}\r\n   ````\r\n",
    "expected": "Visible prose."
  },
  {
    "name": "heading fallback",
    "source": "# Canvas\n## Section\n```tldraw\n## payload heading\n```\n",
    "expected": "Section"
  },
  {
    "name": "short fence inside payload",
    "source": "# Canvas\n````tldraw\n```\n{\"store\":{}}\n````\nAfter.",
    "expected": "After."
  },
  {
    "name": "ordinary code contract",
    "source": "# Code\n```json\n{\"example\":true}\n```\nAfter.",
    "expected": "{\"example\":true} After."
  },
  {
    "name": "literal tldraw inside ordinary fence",
    "source": "# Code\n````text\n```tldraw\nordinary example\n```\n````\nAfter.",
    "expected": "ordinary example After."
  },
  {
    "name": "unclosed fence preserves following prose",
    "source": "# Canvas\nBefore.\n```tldraw\nUnclosed example.\nAfter.",
